{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asystent Budowania instruction pack",
  "type": "object",
  "required": [
    "version",
    "title",
    "steps"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "category": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "parts": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "instruction": {
            "type": "string",
            "maxLength": 10000
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "warning": {
            "type": "string",
            "maxLength": 1000
          },
          "duration": {
            "type": "string",
            "maxLength": 80
          },
          "position": {
            "type": "string",
            "maxLength": 300
          },
          "rotation": {
            "type": "string",
            "maxLength": 120
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}